#include <stdio.h>
#include <stdlib.h>

struct Activity {
    int start;
    int finish;
    int id;
};

// Sort according to finish time
int compare(const void *a, const void *b)
{
    struct Activity *x = (struct Activity *)a;
    struct Activity *y = (struct Activity *)b;

    if (x->finish < y->finish)
        return -1;

    if (x->finish > y->finish)
        return 1;

    return 0;
}

void activitySelection(struct Activity activities[], int n)
{
    // Sort by finishing time
    qsort(activities, n, sizeof(struct Activity), compare);

    printf("Selected Activities:\n");

    // Select first activity
    int last = 0;

    printf("A%d (%d, %d)\n",
           activities[last].id,
           activities[last].start,
           activities[last].finish);

    // Select remaining compatible activities
    for (int i = 1; i < n; i++)
    {
        if (activities[i].start >= activities[last].finish)
        {
            printf("A%d (%d, %d)\n",
                   activities[i].id,
                   activities[i].start,
                   activities[i].finish);

            last = i;
        }
    }
}

int main()
{
    struct Activity activities[] = {
        {1, 2, 1},
        {3, 4, 2},
        {0, 6, 3},
        {5, 7, 4},
        {8, 9, 5},
        {5, 9, 6}
    };

    int n = sizeof(activities) / sizeof(activities[0]);

    activitySelection(activities, n);

    return 0;
}
